# Скопируйте этот файл в .env и подставьте свои значения.
# .env в репозиторий не попадает (см. .gitignore) — это и есть требование
# п. 8.2 ТЗ: "Секреты подключения к БД и реальные пароли в репозиторий
# не включаются."

SECRET_KEY=change-me-to-a-random-string

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/menu_stolovoy

TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/menu_stolovoy_test

FLASK_ENV=development

POSTGRES_DB=menu_stolovoy
POSTGRES_USER=menu_user
POSTGRES_PASSWORD=postgres
